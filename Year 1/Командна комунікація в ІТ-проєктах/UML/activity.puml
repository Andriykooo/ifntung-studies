@startuml
skinparam dpi 150
skinparam activity {
  BackgroundColor #F4F6FA
  BorderColor #2F5597
  DiamondBackgroundColor #FFF2CC
  DiamondBorderColor #BF9000
}
title Діаграма активностей процесу «Прочитати книгу»
|Читач|
start
repeat
  :Ввести пошуковий запит;
  |Система|
  :Виконати пошук у каталозі;
  :Показати результати пошуку;
  |Читач|
repeat while (Потрібну книгу знайдено?) is (ні) not (так)
:Обрати книгу зі списку;
|Система|
:Показати деталі книги;
|Читач|
:Натиснути «Читати»;
|Система|
if (Користувач авторизований?) then (так)
else (ні)
  :Показати форму входу;
  |Читач|
  :Ввести логін і пароль;
  |Система|
  if (Дані коректні?) then (так)
  else (ні)
    :Показати повідомлення\n«Помилка входу»;
    stop
  endif
endif
if (Книга доступна для читання?) then (так)
  fork
    :Завантажити текст книги;
  fork again
    :Оновити історію читання;
  end fork
  :Відобразити сторінку книги;
  |Читач|
  while (Читати далі?) is (так)
    :Гортати сторінку;
    |Система|
    :Показати наступну сторінку;
    |Читач|
  endwhile (ні)
  :Закрити книгу;
  |Система|
  :Зберегти позицію читання;
  stop
else (ні)
  :Показати повідомлення\n«Книга недоступна»;
  stop
endif
@enduml